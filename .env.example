# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)

# ── Supabase (Project Settings → API) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 공개(publishable) 키: 브라우저에 노출돼도 되는 키. 예전 이름은 anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 비밀(secret) 키: 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 마세요. 예전 이름은 service_role key
SUPABASE_SECRET_KEY=sb_secret_xxx

# ── Anthropic (console.anthropic.com → API Keys) ───────────────
ANTHROPIC_API_KEY=sk-ant-xxx
# 선택: 모델 바꾸기 (기본값: 질문=claude-haiku-4-5, 문서=claude-opus-5-5, 문서 effort=low)
# ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
# ANTHROPIC_DOC_MODEL=claude-opus-5-5
# ANTHROPIC_DOC_EFFORT=low

# ── 토스페이먼츠 (개발자센터 → API 키, "API 개별 연동 키" 사용) ──
# 테스트 키(test_ck_ / test_sk_)로 시작하면 실제 돈이 나가지 않습니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxx
TOSS_SECRET_KEY=test_sk_xxx
